GEMINI_API_KEY = "PASTE_YOUR_KEY_HERE"
GEMINI_MODEL = "gemini-3.5-flash"
# Used once if the main model is busy or out of quota.
GEMINI_FALLBACK_MODEL = "gemini-flash-latest"
# Today's temperature in Doha (°C). Visitors do not see a slider; set this on the morning of the demo.
DEFAULT_TEMP = 27
# Language the app opens in: "ar" or "en". Visitors can switch at the top of the page.
DEFAULT_LANG = "ar"
